  "feature_evidence": {
    "snapshot_auto": {
      "value": false,
      "source": "https://docs.coreweave.com/products/sandboxes/long-running-sandboxes",
      "quote": "Save results or checkpoints outside the sandbox before its lifetime expires.",
      "note": "CoreWeave Sandboxes: lifetime expiry terminates the sandbox without saving; snapshot-on-stop exists but is an explicit opt-in flag on the stop call (StopSandbox fileSystemSnapshotOnStop=true / sandbox.stop(snapshot_on_stop=True)); the first-party cws-agent CLI's `stop` snapshots the workspace by default (client-side default, still a user call). CKS GPU nodes: no machine snapshots. Scheduled, not stop-triggered: Distributed File Storage volumes get a `.snapshot` folder, 'Snapshots ... occur every 6 hours and persist for 72 hours'.",
      "checked": "2026-09-29"
    },
    "snapshot_on_demand": {
      "value": true,
      "source": "https://docs.coreweave.com/products/sandboxes/file-system-snapshots",
      "quote": "A mid-life snapshot captures a running sandbox without stopping it. The sandbox keeps running afterward.",
      "note": "Sandboxes only (public preview). File System Snapshots: tarball of one chosen working-directory mount (EmptyDir scratch) to object storage (CoreWeave-managed or bring-your-own bucket); filesystem only, no memory/processes, not the whole root FS. New sandboxes can restore it and 'fork one snapshot into several sandboxes'. Also snapshot-on-stop. CKS PVCs can use Kubernetes VolumeSnapshots.",
      "checked": "2026-09-29"
    },
    "harness_api": {
      "value": true,
      "source": "https://github.com/coreweave/cws-agent",
      "quote": "cws-agent session start project1 fix-auth --prompt \"Fix the login bug\"",
      "note": "First-party (coreweave GitHub org, Apache 2.0) CLI cws-agent: `cws-agent AGENT [NAME]` launches claude, codex, devin, opencode or cursor in a sandbox; starts parallel agent sessions with a prompt (git worktree per task), attach/diff, `cws-agent resume` lists/resumes conversations across running and saved workspaces, `cws-agent run api1 \"task\"` for OpenAI Agents API workers, Telegram/Discord chat bridges. CLI only (no documented REST/SDK harness endpoint or event stream API); docs also list integrations for Claude Managed Agents, OpenAI Agents API, Devin Outposts, Pi, Muse Code.",
      "checked": "2026-09-29"
    },
    "egress_allowlist": {
      "value": true,
