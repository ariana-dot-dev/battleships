  "feature_evidence": {
    "snapshot_auto": {
      "value": false,
      "source": "https://cloud.google.com/build/docs/build-config-file-schema",
      "quote": "Upon completion of the\nbuild, volumes and their contents are discarded.",
      "note": "Job-scoped ephemeral build workers; nothing is saved when a build ends (only pushed images/artifacts and optional caches you upload yourself).",
      "checked": "2026-09-29"
    },
    "snapshot_on_demand": {
      "value": false,
      "source": null,
      "quote": null,
      "note": "No snapshot/checkpoint API for build workers anywhere in the Cloud Build docs; card models snapshot 'none'.",
      "checked": "2026-09-29"
    },
    "harness_api": {
      "value": false,
      "source": null,
      "quote": null,
      "note": "CI build service; runs container steps. No agent harness API (you could run an agent CLI as a build step, but that is generic exec).",
      "checked": "2026-09-29"
    },
    "egress_allowlist": {
      "value": true,
      "source": "https://cloud.google.com/build/docs/private-pools/use-in-private-network",
      "quote": "Remove public IPs on private pools by setting egressOption field in the private pool config file to NO_PUBLIC_EGRESS.\nThis will remove all access from the private pool to the public internet.",
      "note": "Private pools only (default pool always has internet). Options: NO_PUBLIC_EGRESS (no-internet mode, gcloud --no-public-egress), VPC Service Controls perimeter, and 'Customize firewall rules on your VPC network to restrict egress' on the peered VPC (IP/CIDR/port). Per pool, not per build; enforced outside the worker.",
      "checked": "2026-09-29",
      "level": "ip"
    },
    "ingress_rules": {
      "value": false,
      "source": "https://cloud.google.com/build/docs/private-pools/private-pools-overview",
      "quote": "its own worker and is isolated from other workloads.",
      "note": "Build workers expose no inbound ports/URLs at all, so there is nothing to control (not a 'public with no controls' case). The VPC-SC 'ingress policy' in the docs governs who may call the Cloud Build API, not traffic to workers.",
      "checked": "2026-09-29"
    },
    "secret_proxy": {
      "value": false,
      "source": "https://cloud.google.com/build/docs/securing-builds/use-secrets",
      "quote": "env: a local name (environment variable) that build steps can use to\nreference the secret.",
      "note": "Secret Manager secrets (availableSecrets / secretEnv) and KMS-encrypted secrets are injected as environment variables into build steps; no credential-injecting proxy.",
      "checked": "2026-09-29"
    },
    "volume_attach": {
      "value": false,
      "source": "https://cloud.google.com/build/docs/build-config-file-schema",
      "quote": "Each volume is created\nas an empty volume prior to starting the build process. Upon completion of the\nbuild, volumes and their contents are discarded.",
      "note": "Only per-build Docker volumes shared between steps and a configurable diskSizeGb; no persistent/attachable volumes.",
      "checked": "2026-09-29"
    },
    "volume_shared": {
      "value": false,
      "source": "https://cloud.google.com/build/docs/build-config-file-schema",
      "quote": "is a Docker container volume that is mounted into build steps to persist files\nacross build steps.",
      "note": "Build volumes are shared only between sequential steps of the same build on one worker; no cross-worker shared filesystem (use GCS/Filestore over the network yourself).",
      "checked": "2026-09-29"
    }
  }
